# Database Configuration
MONGODB_DBNAME=dairy_shop

# Server Configuration
PORT=8003

# Connection Troubleshooting Notes:
# If you get "querySrv ENOTFOUND" errors:
# 1. Uncomment the alternative MONGODB_URI above and comment out the first one
# 2. Check your internet connection
# 3. Verify your IP is whitelisted in MongoDB Atlas Security settings
# 4. Try connecting from MongoDB Compass with these same credentials
# 5. Check if corporate firewall is blocking MongoDB Atlas ports (27017)

# MongoDB Atlas Whitelist Setup:
# 1. Go to MongoDB Atlas Dashboard
# 2. Navigate to Network Access
# 3. Add your current IP address or use 0.0.0.0/0 for testing (not recommended for production)
# 4. Make sure your cluster is running (not paused)

# Testing Connection:
# You can test the connection using MongoDB Compass or mongosh:
# mongosh "mongodb+srv://admin:zUwJYfxBUS1dfImJ@cluster0.82iazhd.mongodb.net/dairy_shop"